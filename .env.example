# ---- Database ----
# Production (Supabase/Postgres). Leave EMPTY to run locally in-memory
# (schema + seed run automatically on first request). Set PGLITE_DIR to use a
# file-backed local Postgres instead of memory.
DATABASE_URL=
PGLITE_DIR=

# ---- Auth ----
# Change this to a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Admin seed credentials (used on first DB init).
ADMIN_EMAIL=admin@podiumset.ph
ADMIN_PASSWORD=ChangeMe123!

# Base URL used in emails and links.
APP_URL=http://localhost:3000

# ---- Email (SMTP). Leave empty to log emails to console instead. ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PodiumSet <noreply@podiumset.ph>

# ---- Cron ----
# Shared secret required by /api/cron/daily-tick so random people can't run it.
CRON_SECRET=change-me-cron-secret

# ---- Google Drive sync (optional) ----
# When configured, every deliverable upload is mirrored into a per-client
# Google Drive folder, and each client's folder is created automatically at
# onboarding (payment verification). Leave empty to keep files in local uploads.
#
# 1. Create a Google Cloud service account with the "Drive API" enabled and a
#    key in JSON format (roles/google cloud / IAM: give it Editor on the shared
#    Drive folder). Paste the WHOLE JSON as a single line below.
# 2. Share the destination Drive folder with the service account email
#    (reader/editor is fine). Put that folder's ID in GOOGLE_DRIVE_FOLDER_ID
#    (it's the long string after /folders/ in the folder's URL).
GOOGLE_DRIVE_SERVICE_ACCOUNT=
GOOGLE_DRIVE_FOLDER_ID=
